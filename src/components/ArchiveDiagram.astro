---
import { render } from "pele";

// Fixed editorial content rendered at build time. No archive data enters Pele.
const { svg } = render("flowchart LR\n A[Read index] --> B[Pick file] --> C[Preview or save]");
---

<figure class="archive-diagram">
  <figcaption>How PeekZip works <a href="https://pele.run/">Diagram by Pele</a></figcaption>
  <div role="img" aria-label="Read the ZIP index, pick a file, then preview or save it.">
    <div aria-hidden="true" set:html={svg} />
  </div>
</figure>

<style>
  .archive-diagram {
    box-sizing: border-box;
    width: min(100%, 29rem);
    margin: 20px auto;
    padding: 12px 16px 8px;
    background: #000;
    color: #fffdf5;
    --pele-bg: #000;
    --pele-surface: #141414;
    --pele-fg: #fffdf5;
    --pele-border: #99998c;
    --pele-line: #ffdb83;
    --pele-font: Instrument, sans-serif;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
  }
  a { color: #ffe095; font-size: 12px; }
  .archive-diagram :global(svg) { display: block; width: 100%; margin: 4px auto 0; }
  @media (max-width: 420px) {
    .archive-diagram { padding-inline: 8px; }
  }
</style>
